APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public base for generated short links (the redirect host). Defaults to APP_URL.
# Set this when the redirect host differs from the admin/API host (e.g. k8s ingress).
SHORT_URL_BASE=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Host dev writes the single file log; containers add JSON-to-stdout: LOG_STACK=single,stdout (ADR-0004)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observability / metrics (ADR-0004). storage: memory (host, per-process) | redis
# (shared across workers/containers — Compose sets this). /metrics is scraped by Prometheus.
METRICS_ENABLED=true
METRICS_STORAGE=memory
METRICS_NAMESPACE=linkforge
# METRICS_REDIS_HOST / METRICS_REDIS_PORT default to REDIS_HOST/REDIS_PORT.

# DB engine: host SQL Server (ADR-0003). Expect an SQL Server instance reachable
# on the host at 1433; containers reach it via host.docker.internal (see compose).
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=url_shortener
DB_USERNAME=sa
DB_PASSWORD=
# SQL Server over TLS on newer drivers may need:
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis = pure-PHP client (no phpredis extension needed on host); see ADR-0002/0003
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Short codes (ADR-0001): SHORTCODE_KEY keys the reversible obfuscation that makes
# codes non-enumerable — keep it secret; leaking it makes codes guessable. If blank,
# APP_KEY is used. SHORTCODE_MIN_LENGTH left-pads short codes.
SHORTCODE_KEY=
SHORTCODE_MIN_LENGTH=7

# Click-event transport: sync (host dev) | kafka (docker) | log (off)
CLICK_EVENT_DRIVER=sync
KAFKA_BROKERS=localhost:9092
KAFKA_CLICK_TOPIC=url.clicked
KAFKA_CONSUMER_GROUP=linkforge-clicks
KAFKA_CONSUME_TIMEOUT_MS=2000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
