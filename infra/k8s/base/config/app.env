# Environment-agnostic app config (ConfigMap `linkforge-config`).
# Endpoints and per-env values (DB_HOST, REDIS_HOST, KAFKA_BROKERS, APP_URL, …) are
# supplied by each overlay; secrets come from the Secret, never here.
APP_NAME=LinkForge
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stack
LOG_STACK=single,stdout
LOG_LEVEL=info
DB_CONNECTION=sqlsrv
DB_PORT=1433
DB_DATABASE=url_shortener
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
REDIS_CLIENT=predis
REDIS_PORT=6379
CLICK_EVENT_DRIVER=kafka
KAFKA_CLICK_TOPIC=url.clicked
KAFKA_CONSUMER_GROUP=linkforge-clicks
KAFKA_CONSUME_TIMEOUT_MS=2000
METRICS_ENABLED=true
METRICS_STORAGE=redis
METRICS_NAMESPACE=linkforge
SHORTCODE_MIN_LENGTH=7
