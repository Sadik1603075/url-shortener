# Copy to `.env.k8s.local` (gitignored) and fill in REAL values before `kubectl apply`.
# These become the `linkforge-secrets` Secret.
#
#   APP_KEY:    cd backend && php artisan key:generate --show
#   SHORTCODE_KEY: any long random string (keeps short codes non-enumerable, ADR-0001)
#   DB_*:       the host SQL Server credentials (same as backend/.env)

APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show
SHORTCODE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DB_USERNAME=sa
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
