# Local (minikube) overrides merged into `linkforge-config`.
# Endpoints point at in-cluster services (redis, kafka) and the host SQL Server.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://linkforge.local
# Public base for generated short links = the REDIRECT host (not the admin host).
# Includes :8090 because the cluster is reached via `kubectl port-forward …:8090`
# (see docs/run-local-minikube.md §2). Drop the port if you expose the ingress on 80.
SHORT_URL_BASE=http://linkforge.local:8090
DB_HOST=host.minikube.internal
DB_TRUST_SERVER_CERTIFICATE=true
REDIS_HOST=redis
METRICS_REDIS_HOST=redis
KAFKA_BROKERS=kafka:9092
